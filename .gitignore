# Generated by install.sh - contains secrets / is host-specific. Never commit these.
config.json
cert/
tokens.db
pending/
*.log
*.log.[0-9]
*.pid

# Python bytecode (e.g. from running the tests locally)
__pycache__/
*.pyc

# deploy.sh backups and staging (when the app runs from this checkout)
backups/
.deploy-*/
